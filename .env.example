# Copy to .env (which is not committed) and fill in. Read by docker-compose.yml.

# Long random string. Generate one with:
#   python3 -c "import secrets; print(secrets.token_urlsafe(50))"
DJANGO_SECRET_KEY=

# Database password. Avoid the characters $ and # here.
POSTGRES_PASSWORD=

# Host names the site answers to, comma-separated (the domain and/or the server's IP).
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1

# Port on the host the site is published on.
WEB_PORT=8000

# Tunnel token from the Cloudflare Zero Trust dashboard (Networks > Tunnels).
# Point the tunnel's public hostname at http://web:8000.
CLOUDFLARE_TUNNEL_TOKEN=
